# Скопируй в .env и заполни своими значениями.

# Базовый URL REST API. Часто http://хост:5001 БЕЗ /api
# (swagger: /auth/generate). Не веб-плейлист (8088) и не WS (24710/24712).
CARROT_BASE_URL=http://127.0.0.1:5001

# WebSocket команд плейлиста (удаление/создание). Порт 24710.
# CARROT_WS_URL=ws://127.0.0.1:24710

# WebSocket медиа/файлов (MediaAssetLibrary). Порт 24712.
# CARROT_WS_FILE_URL=ws://127.0.0.1:24712

CARROT_LOGIN=admin
CARROT_PASSWORD=changeme

# Локальный Flask UI
# CARROT_WEB_HOST=127.0.0.1
# CARROT_WEB_PORT=3456

# Необязательно — поля конверта запросов.
CARROT_SENDER_ID=ticker-web
CARROT_RECEIVER_ID=carrot-server
