# Скопируй в .env и заполни своими значениями.

# Базовый URL REST API Carrot (хост:порт + /api).
# 8080 ниже — ЗАГЛУШКА, из-за неё будет "fetch failed".
# Подставь адрес, на котором реально крутится REST (не WebSocket 24710/24712).
# На Windows лучше 127.0.0.1, а не localhost.
CARROT_BASE_URL=http://127.0.0.1:8080/api

# Учётные данные пользователя Carrot
CARROT_LOGIN=admin
CARROT_PASSWORD=changeme

# Событие бегущей строки: задай ЛИБО id (точнее), ЛИБО имя.
# CARROT_EVENT_ID=3fa85f64-5717-4562-b3fc-2c963f66afa6
CARROT_EVENT_NAME=Ticker

# Имя текстовой переменной со строками бегущей строки (в шаблоне).
CARROT_TICKER_VAR=inputext

# Для выдачи/снятия в эфир нужен ЭЛЕМЕНТ сценария (item).
# Задай ЛИБО id элемента напрямую:
# CARROT_ITEM_ID=3fa85f64-5717-4562-b3fc-2c963f66afa6
# ЛИБО плейлист, в котором клиент найдёт элемент по событию (см. выше):
# CARROT_PLAYLIST_ID=12f24d2f-93ea-46e1-bcee-b98f6160f1b0

# Если REST на HTTPS с самоподписанным сертификатом:
# CARROT_INSECURE_TLS=1

# Необязательно — поля конверта запросов.
CARROT_SENDER_ID=ticker-client
CARROT_RECEIVER_ID=carrot-server
