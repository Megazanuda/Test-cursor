# Скопируй в .env и заполни своими значениями.

# Базовый URL REST API. Часто это http://хост:5001 БЕЗ /api
# (swagger: /auth/generate). Префикс /api — как в PDF, на части установок.
# Не веб-плейлист (8088) и не WebSocket (24710/24712).
CARROT_BASE_URL=http://127.0.0.1:5001

# WebSocket для команд плейлиста (удаление/создание события). Порт 24710.
# По умолчанию берётся хост из CARROT_BASE_URL и порт 24710.
# CARROT_WS_URL=ws://127.0.0.1:24710

# WebSocket для медиа/файлов (MediaAssetLibrary). Порт 24712 — не путать с 24710.
# CARROT_WS_FILE_URL=ws://127.0.0.1:24712

# Учётные данные пользователя Carrot
CARROT_LOGIN=admin
CARROT_PASSWORD=changeme

# Если REST на HTTPS с самоподписанным сертификатом:
# CARROT_INSECURE_TLS=1

# Необязательно — поля конверта запросов / веб-прокси.
CARROT_SENDER_ID=ticker-web
CARROT_RECEIVER_ID=carrot-server

# Порт локального веб-UI (по умолчанию 3456)
# CARROT_WEB_PORT=3456
# CARROT_WEB_HOST=127.0.0.1
